# PetMate Backend — plantilla de configuración local (T004)
#
# Copie este archivo como `.env` y sustituya los placeholders. El archivo `.env`
# está ignorado por Git; nunca confirme credenciales reales.
# Todos los valores de esta plantilla son ficticios y no funcionan contra
# servicios reales. La fuente normativa es .specify/memory/constitution.md (§4).
#
# Precedencia: toda variable ya presente en el entorno real, incluso vacía, tiene
# prioridad sobre `.env`. En Production efectivo el archivo `.env` no se carga.

# --- MongoDB Atlas: desarrollo ---
MONGODB_URI=mongodb+srv://usuario_ficticio:password_ficticio@cluster-ficticio.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=petmate_dev_ficticio

# --- MongoDB Atlas: base de datos de integración independiente ---
MONGODB_TEST_URI=mongodb+srv://usuario_ficticio:password_ficticio@cluster-ficticio.mongodb.net/?retryWrites=true&w=majority
MONGODB_TEST_DATABASE=petmate_test_ficticio

# --- Redis de autenticación: lista negra de JWT (servicio independiente) ---
REDIS_AUTH_CONNECTION=redis-auth-ficticio:6380,password=password_ficticio,ssl=True

# --- Redis de caché (servicio independiente del de autenticación) ---
REDIS_CACHE_CONNECTION=redis-cache-ficticio:6380,password=password_ficticio,ssl=True

# --- JWT: emisor, audiencia y clave de firma de ejemplo ---
JWT_ISSUER=https://issuer-ficticio.local
JWT_AUDIENCE=petmate-api-ficticio
JWT_SIGNING_KEY=clave_de_firma_placeholder_no_usar
# JWT_SIGNING_KEY debe ser aleatoria y de al menos 256 bits (>= 32 bytes). Genere una propia,
# p. ej. con `openssl rand -base64 48`; fuera de Development se rechazan las plantillas.
# Opcional: vida del access token en minutos (1-60).
# JWT_ACCESS_TOKEN_MINUTES=15

# --- Azure: Blob Storage y CDN (placeholders para tareas posteriores) ---
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=CUENTA_FICTICIA;AccountKey=CLAVE_FICTICIA_PLACEHOLDER;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=petmate-imagenes-ficticio
AZURE_CDN_ENDPOINT=https://cdn-ficticio.azureedge.net

# --- Docker Compose (T011): solo los lee `docker compose`; ASP.NET Core no los consume directamente ---
# Contraseñas de las dos instancias Redis. En Compose, la API deriva sus REDIS_*_CONNECTION de estas
# variables (red interna, sin TLS, solo Development). Use valores aleatorios largos y distintos.
REDIS_AUTH_PASSWORD=password_ficticio_redis_auth
REDIS_CACHE_PASSWORD=password_ficticio_redis_cache
# Puerto de la API en loopback (127.0.0.1). Los Redis no publican puertos por defecto.
API_PORT=8080
# Entorno de la API en Compose. Fuera de Development se exige TLS en Redis (ssl=True).
PETMATE_ENVIRONMENT=Development
# Solo con docker-compose.debug-ports.yml (depuración local en loopback):
REDIS_AUTH_PORT=6381
REDIS_CACHE_PORT=6382

# --- Argon2id (T015): opcionales; por defecto m=65536 KiB, t=3, p=1 ---
# Se rechaza todo valor por debajo del mínimo OWASP (memoria >= 19456 KiB, iteraciones >= 2).
# ARGON2_MEMORY_KIB=65536
# ARGON2_ITERATIONS=3
# Hashes simultáneos (por defecto max(2, núcleos)); espera de 5 s y luego 503.
# ARGON2_MAX_CONCURRENCY=

# --- Autenticación (T019-T021): opcionales ---
# Solicitudes por IP y minuto en register/login/refresh (1-10000).
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Solicitudes por usuario y minuto en /api/v1/pets/* (1-10000; por defecto 60).
# PETS_RATE_LIMIT_PER_MINUTE=60
# IPs de proxies confiables separadas por coma; vacío = ninguno. Detrás de un proxy, sin esto
# la IP observada es la del proxy.
# TRUSTED_PROXIES=
